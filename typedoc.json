{
  "$schema": "https://typedoc.org/schema.json",
  "tsconfig": "tsconfig.json",
  "out": "homepage/docs/api",
  "entryPoints": ["src"],
  "exclude": [
    "**/*.test.ts",
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/*.d.ts",
    "./src/client/.next/**",
    "./src/client/apps/**",
    "./src/client/pages/**",
    "./src/client/public/**",
    "./src/client/next.config.js",
    "./src/electron/helpers/ipc/**",
    "./src/electron/preload.ts",
    "./src/electron/app-preload.ts",
    "./src/electron/background.ts",
    "./homepage/**"
  ],
  "entryPointStrategy": "expand",
  "plugin": ["typedoc-plugin-markdown"],
  "markedOptions": {
    "gfm": true,
    "tables": true
  },
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeExternals": true
}
